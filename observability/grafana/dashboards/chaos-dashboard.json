{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Reset data",
      "type": "link",
      "url": "http://localhost:8000/reset",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "sum(increase(chaos_actions_total[15m]))", "refId": "A"}
      ],
      "title": "Chaos actions (15m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "chaos_active_targets", "refId": "A"}
      ],
      "title": "Active targets",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "sum(chaos_target_fault_active{fault=\"latency\"})", "refId": "A"}
      ],
      "title": "Active latency targets",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "chaos_target_fault_value{fault=\"latency\"}", "legendFormat": "{{target}}", "refId": "A"}
      ],
      "title": "Latency by target",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "sum(chaos_target_fault_active{fault=\"loss\"})", "refId": "A"}
      ],
      "title": "Active loss targets",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 6,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "chaos_target_fault_value{fault=\"loss\"}", "legendFormat": "{{target}}", "refId": "A"}
      ],
      "title": "Loss by target",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "sum by (action) (increase(chaos_actions_total[1m]))", "legendFormat": "{{action}}", "refId": "A"}
      ],
      "title": "Actions in the last minute",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"displayName": "", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 16},
      "id": 8,
      "options": {"showHeader": true},
      "targets": [
        {"expr": "chaos_target_fault_value", "legendFormat": "{{target}} / {{fault}}", "refId": "A"}
      ],
      "title": "Current target fault values",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "id": 13,
      "panels": [],
      "title": "Live probe",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic-by-name"}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 25},
      "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "chaos_probe_rtt_ms{target=~\"$target\"}", "legendFormat": "{{target}}", "refId": "A"}
      ],
      "title": "Live probe latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic-by-name"}, "decimals": 0, "unit": "percent"},
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"dash": [8, 6], "fill": "dash"}},
              {"id": "custom.lineWidth", "value": 1}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 25},
      "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "chaos_probe_loss_percent{target=~\"$target\"}", "legendFormat": "{{target}}", "refId": "A"},
        {"expr": "chaos_probe_loss_percent_avg{target=~\"$target\"}", "legendFormat": "{{target}}", "refId": "B"}
      ],
      "title": "Live probe loss",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"displayName": "${__field.labels.target}", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33},
      "id": 11,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {"expr": "sum by (target) (increase(chaos_probe_failures_total{target=~\"$target\"}[5m]))", "refId": "A"}
      ],
      "title": "Probe failures (5m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"displayName": "${__field.labels.target}", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33},
      "id": 12,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "sum by (target) (increase(chaos_probe_successes_total{target=~\"$target\"}[5m]))", "legendFormat": "{{target}}", "refId": "A"}
      ],
      "title": "Probe successes (5m)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["chaos", "observability"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "definition": "label_values(chaos_probe_rtt_ms, target)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "label": "Probe target",
        "name": "target",
        "options": [],
        "query": "label_values(chaos_probe_rtt_ms, target)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Chaos Dashboard",
  "uid": "chaos-dashboard",
  "version": 1,
  "weekStart": ""
}